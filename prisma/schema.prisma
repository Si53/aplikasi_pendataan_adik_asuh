generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  name               String
  notes              AdminNote[]
  bantuanAdjustments BantuanAdjustment[]
  createdAt          DateTime            @default(now()) @map("created_at")

  @@map("admins")
}

model Pengawas {
  id                  Int                 @id @default(autoincrement())
  username            String              @unique
  password            String // hashed dengan bcrypt
  name                String
  wilayah             String // Pati, Jepara, Ampel, Wonosobo, Sukabumi, Bandung
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?           @map("locked_until")
  students            Student[]
  disbursements       DisbursementProof[]

  @@map("pengawas")
}

model Student {
  id                  Int                 @id @default(autoincrement())
  username            String              @unique
  nik                 String              @unique // plain text, bukan di-hash
  fullName            String              @map("full_name")
  dateOfBirth         DateTime            @map("date_of_birth")
  gender              String
  citaCita            String              @map("cita_cita")
  wilayah             String
  pengawasId          Int                 @map("pengawas_id")
  pengawas            Pengawas            @relation(fields: [pengawasId], references: [id])
  alamatLengkap       String              @map("alamat_lengkap")
  noHp                String              @map("no_hp")
  riwayatPenyakit     String              @map("riwayat_penyakit")
  schoolName          String              @map("school_name")
  gradeLevel          String              @map("grade_level")
  nilaiRataRata       String              @map("nilai_rata_rata")
  jumlahSaudara       Int                 @map("jumlah_saudara")
  status              String              @default("pending") // "pending" | "approved" | "rejected"
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?           @map("locked_until")

  father             Father?
  mother             Mother?
  guardian           Guardian?
  educationCosts     EducationCost[]
  documents          Document[]
  academicUpdates    AcademicUpdate[]
  disbursements      DisbursementProof[]
  adminNotes         AdminNote[]
  bantuanAdjustments BantuanAdjustment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("students")
}

model EducationCost {
  id        Int     @id @default(autoincrement())
  studentId Int     @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String // contoh: "SPP Bulanan", "Uang Buku"
  amount    Int // simpan angka murni (integer rupiah), tanpa format

  @@map("education_costs")
}

model Father {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String // Sehat | Sakit | Meninggal Dunia
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("fathers")
}

model Mother {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("mothers")
}

model Guardian {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("guardians")
}

model Document {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String // "KK" | "RAPOR" | "FOTO_ANAK" | "SKTM" | "PRESTASI"
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("documents")
}

model AcademicUpdate {
  id              Int      @id @default(autoincrement())
  studentId       Int      @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tanggalInput    DateTime @default(now()) @map("tanggal_input")
  kelasSaatItu    String   @map("kelas_saat_itu")
  nilaiRataRata   String   @map("nilai_rata_rata")
  namaSekolahBaru String?  @map("nama_sekolah_baru")
  dokumenRapor    String?  @map("dokumen_rapor")

  @@map("academic_updates")
}

model DisbursementProof {
  id         Int       @id @default(autoincrement())
  studentId  Int       @map("student_id")
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pengawasId Int       @map("pengawas_id")
  pengawas   Pengawas  @relation(fields: [pengawasId], references: [id])
  fileUrl    String    @map("file_url")
  tanggal    DateTime  @default(now())
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")

  @@map("disbursement_proofs")
}

model AdminNote {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId   Int      @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id])
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_notes")
}

model BantuanAdjustment {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId     Int      @map("admin_id")
  admin       Admin    @relation(fields: [adminId], references: [id])
  nominalLama Int      @map("nominal_lama")
  nominalBaru Int      @map("nominal_baru")
  catatan     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bantuan_adjustments")
}

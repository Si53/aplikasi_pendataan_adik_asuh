generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The runtime datasourceUrl in lib/prisma.ts supplies the real Neon URL.
  // Keeping a schema fallback avoids client initialization failing when the
  // preview server does not expose DATABASE_URL as a process environment variable.
  url = "postgresql://localhost:5432/adik_asuh"
}

model Pengawas {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String // hashed dengan bcrypt
  name     String
  wilayah  String // Pati, Jepara, Ampel, Wonosobo, Sukabumi, Bandung
  students Student[]

  @@map("pengawas")
}

model Student {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  nik             String   @unique // plain text, bukan di-hash
  fullName        String   @map("full_name")
  dateOfBirth     DateTime @map("date_of_birth")
  gender          String
  citaCita        String   @map("cita_cita")
  wilayah         String
  pengawasId      Int      @map("pengawas_id")
  pengawas        Pengawas @relation(fields: [pengawasId], references: [id])
  alamatLengkap   String   @map("alamat_lengkap")
  noHp            String   @map("no_hp")
  riwayatPenyakit String   @map("riwayat_penyakit")
  schoolName      String   @map("school_name")
  gradeLevel      String   @map("grade_level")
  nilaiRataRata   String   @map("nilai_rata_rata")
  jumlahSaudara   Int      @map("jumlah_saudara")

  father         Father?
  mother         Mother?
  guardian       Guardian?
  educationCosts EducationCost[]
  documents      Document[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("students")
}

model EducationCost {
  id        Int     @id @default(autoincrement())
  studentId Int     @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String // contoh: "SPP Bulanan", "Uang Buku"
  amount    Int // simpan angka murni (integer rupiah), tanpa format

  @@map("education_costs")
}

model Father {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String // Sehat | Sakit | Meninggal Dunia
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("fathers")
}

model Mother {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("mothers")
}

model Guardian {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique @map("student_id")
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name           String
  status         String
  occupation     String
  incomePerMonth String  @map("income_per_month")
  address        String
  phone          String
  medicalHistory String  @map("medical_history")

  @@map("guardians")
}

model Document {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String // "KK" | "RAPOR" | "FOTO_ANAK"
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("documents")
}
